¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~